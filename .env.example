# --- LLM (Google ADK / Gemini) ---
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
COPILOT_MODEL=gemini-2.5-flash

# --- Shared secrets (dev defaults; change outside local use) ---
ORDERHUB_ADMIN_TOKEN=dev-admin-token
TASKFLOW_JWT_SECRET=dev-only-secret-change-me-32-bytes-min!!
# export TASKFLOW_JWT=$(python scripts/mint_jwt.py)
TASKFLOW_JWT=

# --- Endpoints (defaults match docker-compose) ---
ORDERHUB_URL=http://localhost:18080
ORDERHUB_LOG_PATH=./logs/orderhub.log
KAFKA_BOOTSTRAP=localhost:29092
PG_DSN_RO=postgresql://diag_ro:diag_ro@localhost:5432/orderhub
TASKFLOW_URL=http://localhost:18081
